{
  "name": "braytech-code",
  "displayName": "Braytech Code",
  "description": "Bancos de dados e serviços remotos dentro do VS Code e do Cursor — o mesmo motor da IDE Braytech Code.",
  "version": "0.1.0",
  "publisher": "braytech",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "braytech",
          "title": "Databases",
          "icon": "recursos/barra.svg"
        },
        {
          "id": "braytech-servicos",
          "title": "Services",
          "icon": "recursos/barra-servicos.svg"
        }
      ]
    },
    "views": {
      "braytech": [
        {
          "id": "braytech.databases.arvore",
          "name": "Databases"
        },
        {
          "id": "braytech.databases",
          "name": "Databases (painel da IDE)",
          "type": "webview",
          "visibility": "collapsed"
        }
      ],
      "braytech-servicos": [
        {
          "id": "braytech.servicos.arvore",
          "name": "Services"
        },
        {
          "id": "braytech.servicos",
          "name": "Services (painel da IDE)",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "braytech.recarregar",
        "title": "Braytech: Recarregar conexões",
        "icon": "$(refresh)"
      },
      {
        "command": "braytech.executar",
        "title": "Braytech: Executar consulta",
        "icon": "$(play)"
      },
      {
        "command": "braytech.novaConsulta",
        "title": "Braytech: Nova consulta"
      },
      {
        "command": "braytech.destrancarCofre",
        "title": "Braytech: Destrancar o cofre"
      },
      {
        "command": "braytech.novaConexao",
        "title": "Braytech Code: Nova conexão",
        "icon": "$(add)"
      },
      {
        "command": "braytech.abrirNo",
        "title": "Braytech Code: Ver linhas"
      },
      {
        "command": "braytech.abrirArquivoRemoto",
        "title": "Braytech Code: Abrir arquivo remoto"
      },
      {
        "command": "braytech.enviarArquivos",
        "title": "Braytech: Enviar arquivos para esta pasta",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "braytech.acao.select",
        "title": "Braytech: Abrir consulta"
      },
      {
        "command": "braytech.acao.count",
        "title": "Braytech: Contar linhas (exato)"
      },
      {
        "command": "braytech.acao.ddl",
        "title": "Braytech: Ver DDL"
      },
      {
        "command": "braytech.acao.redis-buscar",
        "title": "Braytech: Abrir busca"
      },
      {
        "command": "braytech.acao.mongo-find",
        "title": "Braytech: Abrir consulta"
      },
      {
        "command": "braytech.acao.pinecone-buscar",
        "title": "Braytech: Abrir busca"
      },
      {
        "command": "braytech.acao.tables",
        "title": "Braytech: Tables"
      },
      {
        "command": "braytech.acao.views",
        "title": "Braytech: Views"
      },
      {
        "command": "braytech.acao.functions",
        "title": "Braytech: Functions"
      },
      {
        "command": "braytech.acao.procedures",
        "title": "Braytech: Procedures"
      },
      {
        "command": "braytech.acao.triggers",
        "title": "Braytech: Triggers"
      },
      {
        "command": "braytech.acao.sequences",
        "title": "Braytech: Sequences"
      },
      {
        "command": "braytech.acao.matviews",
        "title": "Braytech: Materialized Views"
      },
      {
        "command": "braytech.acao.types",
        "title": "Braytech: Types"
      },
      {
        "command": "braytech.acao.events",
        "title": "Braytech: Events"
      },
      {
        "command": "braytech.acao.foreign",
        "title": "Braytech: Foreign Tables"
      },
      {
        "command": "braytech.acao.indexes",
        "title": "Braytech: Indexes"
      },
      {
        "command": "braytech.acao.roles",
        "title": "Braytech: Roles"
      },
      {
        "command": "braytech.acao.users",
        "title": "Braytech: Users"
      },
      {
        "command": "braytech.acao.copiar",
        "title": "Braytech: Copiar tabela"
      },
      {
        "command": "braytech.acao.template-select",
        "title": "Braytech: SELECT"
      },
      {
        "command": "braytech.acao.template-insert",
        "title": "Braytech: INSERT"
      },
      {
        "command": "braytech.acao.template-update",
        "title": "Braytech: UPDATE"
      },
      {
        "command": "braytech.acao.template-delete",
        "title": "Braytech: DELETE"
      },
      {
        "command": "braytech.acao.usuario-create",
        "title": "Braytech: Copiar SQL para criar usuário"
      },
      {
        "command": "braytech.acao.usuario-drop",
        "title": "Braytech: Copiar SQL para APAGAR"
      },
      {
        "command": "braytech.acao.usuario-grant",
        "title": "Braytech: Copiar SQL de GRANT"
      },
      {
        "command": "braytech.acao.usuario-revoke",
        "title": "Braytech: Copiar SQL de REVOKE"
      },
      {
        "command": "braytech.acao.truncate",
        "title": "Braytech: Esvaziar (TRUNCATE)"
      },
      {
        "command": "braytech.acao.esvaziar",
        "title": "Braytech: Esvaziar"
      },
      {
        "command": "braytech.acao.refresh-matview",
        "title": "Braytech: REFRESH"
      },
      {
        "command": "braytech.acao.drop",
        "title": "Braytech: Apagar (DROP)"
      },
      {
        "command": "braytech.acao.drop-view",
        "title": "Braytech: Apagar view (DROP)"
      },
      {
        "command": "braytech.acao.drop-matview",
        "title": "Braytech: Apagar (DROP)"
      },
      {
        "command": "braytech.acao.drop-sequence",
        "title": "Braytech: Apagar (DROP)"
      },
      {
        "command": "braytech.acao.drop-trigger",
        "title": "Braytech: Apagar (DROP)"
      },
      {
        "command": "braytech.acao.drop-event",
        "title": "Braytech: Apagar (DROP)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "braytech.recarregar",
          "when": "view == braytech.databases || view == braytech.servicos || view == braytech.databases.arvore || view == braytech.servicos.arvore",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "braytech.executar",
          "when": "resourceLangId == sql",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "braytech.abrirNo",
          "when": "false"
        },
        {
          "command": "braytech.abrirArquivoRemoto",
          "when": "false"
        },
        {
          "command": "braytech.acao.select",
          "when": "false"
        },
        {
