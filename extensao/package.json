          "when": "viewItem =~ /\\[views\\]/",
          "group": "1_abrir"
        },
        {
          "command": "braytech.acao.functions",
          "when": "viewItem =~ /\\[functions\\]/",
          "group": "1_abrir"
        },
        {
          "command": "braytech.acao.procedures",
          "when": "viewItem =~ /\\[procedures\\]/",
          "group": "1_abrir"
        },
        {
          "command": "braytech.acao.triggers",
          "when": "viewItem =~ /\\[triggers\\]/",
          "group": "1_abrir"
        },
        {
          "command": "braytech.acao.sequences",
          "when": "viewItem =~ /\\[sequences\\]/",
          "group": "1_abrir"
