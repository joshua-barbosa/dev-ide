          "when": "false"
        },
        {
          "command": "braytech.acao.drop-event",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "braytech.enviarArquivos",
          "when": "viewItem =~ /pastaRemota/",
          "group": "0_arquivos"
        },
        {
          "command": "braytech.acao.select",
          "when": "viewItem =~ /\\[select\\]/",
          "group": "1_abrir"
        },
        {
          "command": "braytech.acao.count",
          "when": "viewItem =~ /\\[count\\]/",
          "group": "1_abrir"
        },
        {
          "command": "braytech.acao.ddl",
          "when": "viewItem =~ /\\[ddl\\]/",
          "group": "1_abrir"
        },
        {
          "command": "braytech.acao.redis-buscar",
          "when": "viewItem =~ /\\[redis\\-buscar\\]/",
          "group": "1_abrir"
        },
        {
          "command": "braytech.acao.mongo-find",
          "when": "viewItem =~ /\\[mongo\\-find\\]/",
          "group": "1_abrir"
        },
        {
