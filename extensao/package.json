    "keybindings": [
      {
        "command": "braytech.executar",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceLangId == sql"
      }
    ],
    "configuration": {
      "title": "Braytech Code",
      "properties": {
        "braytech.porta": {
          "type": "number",
          "default": 4321,
          "description": "Porta do motor. Se já houver um Braytech Code de pé nela, a extensão usa o mesmo, em vez de subir outro."
        },
        "braytech.motor": {
          "type": "string",
          "default": "",
          "description": "Caminho para o `dist/server/index.js` do motor. Vazio usa o que vem junto com a extensão."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
